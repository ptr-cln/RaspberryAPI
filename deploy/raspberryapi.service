[Unit]
Description=RaspberryAPI FastAPI service
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/RaspberryAPI
Environment=PATH=/home/pi/RaspberryAPI/.venv/bin
ExecStart=/home/pi/RaspberryAPI/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
